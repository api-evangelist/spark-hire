{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spark Hire Account Interview Questions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
